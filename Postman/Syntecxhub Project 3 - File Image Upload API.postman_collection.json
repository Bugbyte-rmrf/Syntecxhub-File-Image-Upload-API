    {
      "name": "Upload Profile Image",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\n\npm.test(\"Image uploaded successfully\", function () {\n    pm.response.to.have.status(201);\n    pm.expect(response.success).to.eql(true);\n});\n\nif (response.file) {\n    pm.environment.set(\"fileId\", response.file._id);\n    pm.environment.set(\"imageUrl\", response.file.url);\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "description": "test-image.png",
              "src": [
                ""
              ]
            }
          ]
        },
        "url": {
